<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]
</IfModule>

DirectoryIndex index.php

# Disable PHP execution in uploads directory
<Directory "uploads">
    php_flag engine off
</Directory>
