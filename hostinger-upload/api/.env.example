# ============================================
# Pdakoo File Upload API - Environment Variables
# ============================================

# Server Configuration
PORT=3001
NODE_ENV=production

# Firebase Configuration
# Get this from Firebase Console -> Project Settings -> Service Accounts
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","..."}
FIREBASE_DATABASE_URL=https://codepdakoo.firebaseio.com

# API Base URL (for frontend to know where to upload)
API_BASE_URL=https://your-hostinger-domain.com/api

# Allowed Origins for CORS
ALLOWED_ORIGINS=https://pdakoo.com,https://www.pdakoo.com,http://localhost:4176
