# Copy this file to .env for production deployment

# ===============================================
# HOSTINGER SMTP CONFIGURATION - EMAIL SYSTEM
# ===============================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@pdakoo.in
SMTP_PASS=@Pdakoo@2004
SMTP_FROM=contact@pdakoo.in
SMTP_REPLY_TO=contact@pdakoo.in
ADMIN_EMAIL=contact@pdakoo.in

# ===============================================
# API CONFIGURATION
# ===============================================
API_BASE_URL=https://api.pdakoo.in
ALLOWED_ORIGINS=https://pdakoo.in,https://www.pdakoo.in,https://api.pdakoo.in

# ===============================================
# FILE UPLOAD CONFIGURATION
# ===============================================
MAX_FILE_SIZE=209715200
MAX_FILES_PER_REQUEST=20
UPLOAD_DIR=./uploads

# ============================================
# LOGGING
# ============================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

